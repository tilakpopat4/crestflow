# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your_gemini_api_key_here"

# APP_URL: Canonical URL where CrestFlow is hosted.
APP_URL="https://crestflow.app"

# RESEND_API_KEY: Resend Transactional Email API Key (re_...)
# Set via: npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY="re_placeholder_secret_key"

# RESEND_FROM_EMAIL: Sender address (e.g. CrestFlow <billing@crestflow.com> or onboarding testing sender)
RESEND_FROM_EMAIL="CrestFlow <billing@crestflow.com>"

# CRON_SECRET: Secret token for authenticating /api/reconcile-cron and /api/email/process-queue
# Set via: npx wrangler secret put CRON_SECRET
CRON_SECRET="your_strong_random_cron_secret"

# FIREBASE_SERVICE_ACCOUNT: Service account credentials JSON as single-line string
# Set via: npx wrangler secret put FIREBASE_SERVICE_ACCOUNT
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com"}'

# RAZORPAY API CREDENTIALS
# Set via: npx wrangler secret put RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET / RAZORPAY_WEBHOOK_SECRET
RAZORPAY_KEY_ID="rzp_live_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

