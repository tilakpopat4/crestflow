rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email == 'tilakpopat2007@gmail.com') ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email.lower()))) ||
        request.auth.token.admin == true
      );
    }

    function isClient(clientEmail) {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email != null
        && request.auth.token.email == clientEmail;
    }

    // Server-written authoritative entitlement check:
    // Requires entitlements/{uid} document, allowed active state, and validUntil > request.time.
    // Missing entitlement doc = denied.
    function entitled(uid) {
      return isSignedIn()
        && request.auth.uid == uid
        && exists(/databases/$(database)/documents/entitlements/$(uid))
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.status in ['trialing', 'active', 'grace']
        && get(/databases/$(database)/documents/entitlements/$(uid)).data.validUntil > request.time;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidClient(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (data.name is string && data.name.size() > 0 && data.name.size() <= 200)
        && (!('company' in data) || (data.company is string && data.company.size() <= 200))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200 && data.email == data.email.lower()))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('currency' in data) || (data.currency is string && data.currency.size() <= 10))
        && (!('rate' in data) || (data.rate is number || data.rate is int))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50));
    }

    function isValidInvoice(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (!('invoiceNumber' in data) || (data.invoiceNumber is string && data.invoiceNumber.size() <= 100))
        && (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 200))
        && (!('totalAmount' in data) || (data.totalAmount is number || data.totalAmount is int))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('clientEmail' in data) || (data.clientEmail is string && data.clientEmail.size() <= 200 && data.clientEmail == data.clientEmail.lower()));
    }

    function isValidWorkItem(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('clientEmail' in data) || (data.clientEmail is string && data.clientEmail.size() <= 200 && data.clientEmail == data.clientEmail.lower()));
    }

    function isValidProfile(data) {
      return (!('userId' in data) || (data.userId is string && data.userId == request.auth.uid))
        && (!('id' in data) || (data.id is string && data.id.size() <= 128))
        && (!('username' in data) || (data.username is string && data.username.size() <= 100))
        && (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('upiId' in data) || (data.upiId is string && data.upiId.size() <= 100))
        && (!('professionalTitle' in data) || (data.professionalTitle is string && data.professionalTitle.size() <= 200))
        && (!('servicesDescription' in data) || (data.servicesDescription is string && data.servicesDescription.size() <= 2000))
        && (!('freelanceStartDate' in data) || (data.freelanceStartDate is string && data.freelanceStartDate.size() <= 50))
        && (!('workExperienceBio' in data) || (data.workExperienceBio is string && data.workExperienceBio.size() <= 5000))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 250000))
        && (!('sampleWorks' in data) || (data.sampleWorks is list))
        && (!('isPublicProfile' in data) || (data.isPublicProfile is bool))
        && (!('gettingStartedDismissed' in data) || (data.gettingStartedDismissed is bool))
        && (!('createdAt' in data) || (data.createdAt is number || data.createdAt is int))
        && (!('updatedAt' in data) || (data.updatedAt is number || data.updatedAt is int));
    }

    function isValidNote(data) {
      return data.userId is string && data.userId == request.auth.uid
        && (!('title' in data) || (data.title is string && data.title.size() <= 300))
        && (!('content' in data) || (data.content is string && data.content.size() <= 5000));
    }

    // 0. Server-Written Entitlements (Client read own doc only; never write)
    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // 0b. Single-Trial Anti-Abuse Claims (Worker transaction only; client read/write denied)
    match /trialClaims/{claimId} {
      allow read, write: if false;
    }

    // 0c. Token-Scoped Public Invoice Shares (Worker served; direct SDK access denied)
    match /invoice_shares/{invoiceId} {
      allow read, write: if false;
    }

    // 1. Clients (Owner read always allowed so export works even expired)
    match /clients/{clientId} {
      allow read: if isOwner(resource.data.userId) || (('email' in resource.data) && isClient(resource.data.email)) || isAdmin();
      allow delete: if isOwner(resource.data.userId) && entitled(request.auth.uid);
      allow create: if isOwner(request.resource.data.userId) && entitled(request.auth.uid) && isValidId(clientId) && isValidClient(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && entitled(request.auth.uid) && isValidClient(request.resource.data);
    }

    // 2. Invoices (Owner read always allowed so export works even expired)
    match /invoices/{invoiceId} {
      allow read: if isOwner(resource.data.userId) || (('clientEmail' in resource.data) && isClient(resource.data.clientEmail)) || isAdmin();
      allow delete: if isOwner(resource.data.userId) && entitled(request.auth.uid);
      allow create: if isOwner(request.resource.data.userId) && entitled(request.auth.uid) && isValidId(invoiceId) && isValidInvoice(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && entitled(request.auth.uid) && isValidInvoice(request.resource.data);
    }

    // 3. Work Items (Owner read always allowed; client review feedback stays functional)
    match /workItems/{workItemId} {
      allow read: if isOwner(resource.data.userId) || (('clientEmail' in resource.data) && isClient(resource.data.clientEmail)) || isAdmin();
      allow delete: if isOwner(resource.data.userId) && entitled(request.auth.uid);
      allow create: if isOwner(request.resource.data.userId) && entitled(request.auth.uid) && isValidId(workItemId) && isValidWorkItem(request.resource.data);
      allow update: if (isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && entitled(request.auth.uid) && isValidWorkItem(request.resource.data))
        || (('clientEmail' in resource.data) && isClient(resource.data.clientEmail) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'comments', 'revisionCount', 'approvedAt', 'updatedAt']) && (!('approvalStatus' in request.resource.data) || request.resource.data.approvalStatus in ['pending_review', 'approved', 'changes_requested']) && (!('revisionCount' in request.resource.data) || request.resource.data.revisionCount is int));
    }

    // 4. Profiles (Safe edits allowed signed-in; username/public content & protected fields locked after expiry)
    match /profiles/{profileId} {
      allow read: if isSignedIn() && (request.auth.uid == profileId || (resource != null && 'userId' in resource.data && request.auth.uid == resource.data.userId) || isAdmin());
      allow create: if isSignedIn()
        && isOwner(profileId)
        && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
        && isValidProfile(request.resource.data)
        && (!request.resource.data.keys().hasAny(['admin', 'isAdmin', 'is_admin', 'plan', 'entitlement', 'entitlementStatus', 'validUntil', 'subscriptionPlan', 'subscriptionStatus', 'accessUntil', 'trialUsed', 'trialClaimed', 'trialClaimedAt', 'trialStartedAt', 'trialEndsAt', 'hasHadTrial', 'razorpaySubscriptionId', 'cancelAtPeriodEnd']))
        && ((!('username' in request.resource.data) && !('sampleWorks' in request.resource.data)) || entitled(profileId));
      allow update: if isSignedIn()
        && isOwner(profileId)
        && (resource == null || !('userId' in resource.data) || request.auth.uid == resource.data.userId)
        && isValidProfile(request.resource.data)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'isAdmin', 'is_admin', 'plan', 'entitlement', 'entitlementStatus', 'validUntil', 'subscriptionPlan', 'subscriptionStatus', 'currentPeriodEnd', 'currentPeriodStart', 'razorpaySubscriptionId', 'cancelAtPeriodEnd', 'accessUntil', 'trialUsed', 'trialClaimed', 'trialClaimedAt', 'trialStartedAt', 'trialEndsAt', 'hasHadTrial', 'createdAt']))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'sampleWorks']) || entitled(profileId));
      allow delete: if isOwner(profileId);

      match /private/{docId} {
        allow read: if isOwner(profileId);
        allow write: if isOwner(profileId) && entitled(profileId);
      }
    }

    // 4b. Public Profiles (Existing remain readable; creating/updating new public content requires entitlement)
    match /public_profiles/{profileId} {
      allow read: if true;
      allow write: if entitled(request.auth.uid) && (
        request.auth.uid == profileId ||
        (resource != null && 'userId' in resource.data && resource.data.userId == request.auth.uid) ||
        (request.resource != null && 'userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
      );
    }

    // 5. Notes
    match /notes/{noteId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) && entitled(request.auth.uid);
      allow create: if isOwner(request.resource.data.userId) && entitled(request.auth.uid) && isValidId(noteId) && isValidNote(request.resource.data);
      allow update: if isOwner(resource.data.userId) && isOwner(request.resource.data.userId) && entitled(request.auth.uid) && isValidNote(request.resource.data);
    }

    // 6. Reviews (Client submission allowed; owner read always allowed; owner moderation/delete requires entitlement)
    match /reviews/{reviewId} {
      allow read: if (('isApproved' in resource.data) && resource.data.isApproved == true)
        || isOwner(resource.data.userId)
        || (resource != null && 'reviewerUid' in resource.data && resource.data.reviewerUid == request.auth.uid)
        || isAdmin();
      allow delete: if isOwner(resource.data.userId) && entitled(request.auth.uid);
      allow create: if isSignedIn()
        && isValidId(reviewId)
        && request.resource.data.keys().hasOnly(['id', 'userId', 'clientId', 'clientName', 'projectName', 'rating', 'feedbackText', 'createdAt', 'isApproved', 'reviewerUid', 'reviewerEmail'])
        && request.resource.data.isApproved == false
        && request.resource.data.userId is string
        && request.resource.data.userId != request.auth.uid
        && (!('reviewerUid' in request.resource.data) || request.resource.data.reviewerUid == request.auth.uid)
        && request.resource.data.clientName is string
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.feedbackText is string && request.resource.data.feedbackText.size() <= 2000;
      allow update: if isOwner(resource.data.userId)
        && entitled(request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isApproved'])
        && request.resource.data.isApproved is bool;
    }

    // 7. Service Requests (Signed-in intake leads received; owner actions require entitlement)
    match /serviceRequests/{requestId} {
      allow create: if isSignedIn()
        && isValidId(requestId)
        && request.resource.data.keys().hasOnly(['id', 'userId', 'clientName', 'contactName', 'contactPhone', 'contactEmail', 'projectDetails', 'instagram', 'proposedRate', 'status', 'createdAt', 'submittedByUid', 'submittedByEmail'])
        && request.resource.data.userId is string
        && request.resource.data.clientName is string
        && request.resource.data.projectDetails is string && request.resource.data.projectDetails.size() <= 2000
        && (!('submittedByUid' in request.resource.data) || request.resource.data.submittedByUid == request.auth.uid);
      allow read: if isOwner(resource.data.userId)
        || (resource != null && 'submittedByUid' in resource.data && resource.data.submittedByUid == request.auth.uid)
        || isAdmin();
      allow update, delete: if isOwner(resource.data.userId) && entitled(request.auth.uid);
    }

    // 8. Blocked Users
    match /blocked_users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 9. Connection Diagnostics
    match /_connection_test/{docId} {
      allow read: if true;
    }

    // 10. Platform & System Settings (Worker service account only)
    match /platform_settings/{settingId} {
      allow read, write: if false;
    }
    match /system_settings/{settingId} {
      allow read, write: if false;
    }

    // 11. Legacy Subscriptions / Ledgers (Read-only transition or client-denied)
    match /subscriptions/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }
    match /trial_ledger/{hash} {
      allow read, write: if false;
    }
    match /usage_ledger/{ledgerId} {
      allow read, write: if false;
    }
    match /webhook_events/{eventId} {
      allow read, write: if false;
    }
    match /processed_events/{eventId} {
      allow read, write: if false;
    }

    // 12. Admin Users & Whitelist
    match /subscription_whitelist/{email} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /admin_users/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
