{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crestflow",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  // Cloudflare R2 bucket binding for custom videos (uncomment once bucket 'crestflow-videos' is created in Cloudflare Dashboard -> R2)
  // "r2_buckets": [
  //   {
  //     "binding": "VIDEOS_BUCKET",
  //     "bucket_name": "crestflow-videos"
  //   }
  // ],
  "vars": {
    "BASE_URL": "https://crestflow.space",
    "RESEND_FROM_EMAIL": "CrestFlow <onboarding@resend.dev>",
    "EMAILJS_SERVICE_ID": "service_u6nm96l",
    "EMAILJS_TEMPLATE_ID": "template_g3ojhpa",
    "EMAILJS_PUBLIC_KEY": "MY75lMNsMx8rYRLa4",
    "VITE_HERO_VIDEO_MP4": "https://n0ohengfxq.ufs.sh/f/5eQObb6EGfZURJzJcIAi9haOpYM4NLEoy2zs3KJtPI1DB6xn"
  },
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
