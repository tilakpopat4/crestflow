{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crestflow",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "vars": {
    "BASE_URL": "https://crestflow.app",
    "EMAILJS_SERVICE_ID": "service_u6nm96l",
    "EMAILJS_TEMPLATE_ID": "template_g3ojhpa",
    "EMAILJS_PUBLIC_KEY": "MY75lMNsMx8rYRLa4"
  },
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
